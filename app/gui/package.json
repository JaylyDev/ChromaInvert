{
  "author": {
    "name": "ChromaInvert contributors",
    "email": "65847850+JaylyDev@users.noreply.github.com"
  },
  "homepage": "https://github.com/JaylyDev/ChromaInvert",
  "description": "ChromaInvert product GUI: Electron + React driving the job.json contract",
  "license": "Apache-2.0",
  "main": "dist-electron/electron/main.js",
  "name": "chromainvert-gui",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.electron.json && node -e \"require('fs').writeFileSync('dist-electron/package.json',JSON.stringify({type:'commonjs'}))\" && vite build",
    "build:renderer": "vite build",
    "dev": "vite",
    "electron:dev": "tsc -p tsconfig.electron.json && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron dist-electron/electron/main.js",
    "start": "electron dist-electron/electron/main.js",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --publish never --dir",
    "dist:win": "npm run build && electron-builder --publish never --win",
    "dist:mac": "npm run build && electron-builder --publish never --mac",
    "dist:linux": "npm run build && electron-builder --publish never --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "type": "module",
  "version": "0.1.0",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.chromainvert.gui",
    "productName": "ChromaInvert",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": { "target": ["nsis", "portable"], "signAndEditExecutable": false, "icon": "assets/icon.ico" },
    "mac": { "target": ["dmg", "zip"], "icon": "assets/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "icon": "assets/icon.png" }
  }
}
